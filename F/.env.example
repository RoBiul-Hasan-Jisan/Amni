# SQLite is fine for local dev — zero setup. For production, swap this for
# a Postgres URL (Supabase/Neon/Vercel Postgres) and change the provider in
# prisma/schema.prisma from "sqlite" to "postgresql".
DATABASE_URL="file:./dev.db"

# Generate one with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-random-32-byte-secret"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
